---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import ApiReference from '../../components/docs/ApiReference.astro';
import { docsOrder, docsMdHref, sectionOf } from '../../lib/docs-nav';
import { loadApi, slugify } from '../../lib/openapi';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  const known = entries.filter((e) => docsOrder.includes(e.id));
  const missing = docsOrder.filter((s) => !entries.some((e) => e.id === s));
  if (missing.length) console.warn(`[docs] pages in the sidebar without a file: ${missing.join(', ')}`);
  const extra = entries.filter((e) => !docsOrder.includes(e.id)).map((e) => e.id);
  if (extra.length) console.warn(`[docs] files not in the sidebar: ${extra.join(', ')}`);
  const sorted = known.sort((a, b) => docsOrder.indexOf(a.id) - docsOrder.indexOf(b.id));
  const labels = Object.fromEntries(sorted.map((e) => [e.id, e.data.sidebarTitle ?? e.data.title]));
  return sorted.map((entry, i) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: {
      entry,
      labels,
      prev: i > 0 ? { slug: sorted[i - 1].id, title: labels[sorted[i - 1].id] } : undefined,
      next: i < sorted.length - 1 ? { slug: sorted[i + 1].id, title: labels[sorted[i + 1].id] } : undefined,
    },
  }));
}

const { entry, labels, prev, next } = Astro.props;
// The docs home starts with the main paths.
const startHere = ['quick-start', 'install', 'first-payment', 'migrate', 'api-reference', 'security-model'];
const cards =
  entry.id === 'index'
    ? (await getCollection('docs'))
        .filter((e) => startHere.includes(e.id))
        .sort((a, b) => startHere.indexOf(a.id) - startHere.indexOf(b.id))
    : [];
const { Content, headings } = await render(entry);
const isApi = entry.id === 'api-reference';
const api = isApi ? loadApi() : null;
const allHeadings =
  isApi && api
    ? [
        ...headings,
        ...api.groups.flatMap((g) => [
          { depth: 2, slug: g.slug, text: g.name },
          ...g.ops.map((op) => ({ depth: 3, slug: slugify(op.id), text: `${op.method} ${op.path}` })),
        ]),
      ]
    : headings;
---

<DocsLayout
  slug={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  section={sectionOf(entry.id)}
  headings={allHeadings}
  labels={labels}
  prev={prev}
  next={next}
  markdownUrl={docsMdHref(entry.id)}
>
  {
    cards.length > 0 && (
      <ul class="start-cards" data-pagefind-ignore>
        {cards.map((c, i) => (
          <li>
            <a href={`/docs/${c.id}/`}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <strong>{c.data.title}</strong>
              <span class="d">{c.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <Content />
  {isApi && <ApiReference api={api} />}
</DocsLayout>

<style>
  .start-cards {
    list-style: none;
    margin: 0 0 var(--space-7);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
  }
  .start-cards li {
    margin: 0;
  }
  .start-cards a {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: var(--space-5);
    background: var(--bg);
    text-decoration: none;
    transition: background-color 140ms;
  }
  .start-cards a:hover {
    background: var(--surface);
  }
  .start-cards .n {
    font: 500 0.6875rem var(--mono);
    color: var(--muted);
  }
  .start-cards strong {
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg);
  }
  .start-cards .d {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .start-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
