---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Sidebar from '../components/docs/Sidebar.astro';
import Toc from '../components/docs/Toc.astro';
import PrevNext from '../components/docs/PrevNext.astro';
import Icon from '../components/Icon.astro';
import '../styles/docs.css';

interface Item {
  slug: string;
  title: string;
}
interface Props {
  slug: string;
  title: string;
  description: string;
  section?: string;
  headings: MarkdownHeading[];
  labels: Record<string, string>;
  prev?: Item;
  next?: Item;
  markdownUrl: string;
}
const { slug, title, description, section, headings, labels, prev, next, markdownUrl } = Astro.props;
const editUrl = `https://github.com/loruorg/turmite/edit/main/site/src/content/docs/${slug}.md`;
const pageTitle = slug === 'index' ? 'Docs' : title;
---

<Base title={pageTitle} description={description} current="docs" themed tools footer={false} markdownUrl={markdownUrl}>
  <div class="docs">
    <aside class="docs-sidebar" aria-label="Documentation">
      <nav aria-label="Documentation"><Sidebar current={slug} labels={labels} /></nav>
    </aside>
    <main id="main" class="docs-main">
      <details class="docs-menu">
        <summary>
          <span class="sec">{section}</span>
          <span>{labels[slug]}</span>
          <Icon name="arrow" size={16} />
        </summary>
        <nav aria-label="Documentation"><Sidebar current={slug} labels={labels} /></nav>
      </details>
      <article data-pagefind-body>
        <header class="doc-head">
          {section && <span class="eyebrow" data-pagefind-ignore>{section}</span>}
          <h1>{title}</h1>
          <p class="lead">{description}</p>
          <div class="doc-actions" data-pagefind-ignore>
            <button type="button" data-copy-page={markdownUrl} hidden>
              <Icon name="copy" /><span>Copy page</span>
            </button>
            <a href={markdownUrl}><Icon name="file" /><span>Markdown</span></a>
          </div>
        </header>
        <div class="prose">
          <slot />
        </div>
      </article>
      <PrevNext prev={prev} next={next} />
      <footer class="docs-foot">
        <span>MIT license. Turmite contributors.</span>
        <a href={editUrl}>Edit this page on GitHub</a>
      </footer>
    </main>
    <aside class="docs-aside" aria-label="On this page">
      <Toc headings={headings} />
    </aside>
  </div>
  <dialog class="search" data-search aria-label="Search docs">
    <form method="dialog" role="search">
      <Icon name="search" size={18} />
      <label class="visually-hidden" for="search-q">Search docs</label>
      <input id="search-q" type="search" placeholder="Search docs" autocomplete="off" spellcheck="false" />
      <button type="button" data-search-close aria-label="Close search">ESC</button>
    </form>
    <ol class="results"></ol>
    <p class="status" role="status"></p>
  </dialog>
</Base>

<script>
  import '../scripts/docs';
  import '../scripts/search';
</script>
