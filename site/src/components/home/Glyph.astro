---
import { glyphs } from '../../lib/coins';
interface Props {
  code: string;
  size?: number;
  class?: string;
}
const { code, size = 28, class: cls } = Astro.props;
const g = glyphs[code];
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    g.stroke ? (
      <path d={g.d} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    ) : (
      <path d={g.d} fill="currentColor" />
    )
  }
</svg>
