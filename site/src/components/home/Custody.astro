---
import Glyph from './Glyph.astro';
import Icon from '../Icon.astro';

const models = [
  {
    codes: ['BTC'],
    name: 'Bitcoin',
    model: 'Watch-only',
    text: 'Turmite derives addresses from your BIP84 account xpub. Payments go straight to your wallet. The server holds no Bitcoin key.',
    risk: 'A server compromise cannot spend.',
  },
  {
    codes: ['XMR'],
    name: 'Monero',
    model: 'View key',
    text: 'Turmite reads incoming payments with your address and private view key. Payments go straight to your wallet.',
    risk: 'A server compromise cannot spend.',
  },
  {
    codes: ['ETH', 'BASE', 'POLYGON', 'BSC'],
    name: 'Ethereum, Base, Polygon, BNB Smart Chain',
    model: 'Deposit contract',
    text: 'Each payment gets a CREATE2 contract. It can only send to the cold wallet fixed in your factory.',
    risk: 'A server compromise cannot redirect deposits.',
  },
  {
    codes: ['TRON', 'SOL', 'TON'],
    name: 'Tron, Solana, TON',
    model: 'Swept',
    text: 'Each payment gets its own key from the deposit seed. The worker sweeps the funds to your cold wallet.',
    risk: 'Unswept deposits are at risk until the sweep.',
  },
];
---

<section class="section" aria-labelledby="custody-title">
  <div class="wrap">
    <header class="sec-head">
      <span class="sec-num">05 Custody</span>
      <h2 id="custody-title">Keys stay off the server where the chain allows it.</h2>
      <p>
        The <code>api</code> process faces the internet and holds no private key. Only the <code>worker</code> can decrypt
        hot keys and the deposit seed. It opens no port.
      </p>
    </header>
    <ul class="cards">
      {
        models.map((m, i) => (
          <li class="card reveal" style={`--i:${i}`}>
            <div class="glyphs">
              {m.codes.map((c) => (
                <Glyph code={c} size={22} />
              ))}
            </div>
            <span class="model">{m.model}</span>
            <h3>{m.name}</h3>
            <p>{m.text}</p>
            <p class="risk">{m.risk}</p>
          </li>
        ))
      }
    </ul>
    <p class="more-row"><a class="more" href="/docs/security-model/">Security model <Icon name="arrow" /></a></p>
  </div>
</section>

<style>
  .sec-head code {
    font-size: 0.85em;
    padding: 0.1em 0.3em;
    background: var(--surface-2);
    color: var(--fg);
  }
  .cards {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--fg);
    border: 1px solid var(--fg);
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-5);
    background: var(--bg);
  }
  .glyphs {
    display: flex;
    gap: 10px;
    color: var(--fg);
    margin-bottom: var(--space-7);
  }
  .model {
    font: 500 0.6875rem var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card h3 {
    margin-top: var(--space-2);
    font-size: 1.125rem;
    letter-spacing: -0.018em;
    line-height: 1.3;
  }
  .card p {
    margin-top: var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .card .risk {
    margin-top: auto;
    padding-top: var(--space-5);
    color: var(--fg);
    font-weight: 550;
    font-size: 0.875rem;
  }
  .more-row {
    margin-top: var(--space-6);
  }
  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .glyphs {
      margin-bottom: var(--space-5);
    }
  }
</style>
