# Optional settings for the testnet stack. Copy to .env next to docker-compose.yml.

# Public Monero stagenet node for the profile `public` wallet-rpcs.
TURMITE_XMR_STAGENET_DAEMON=stagenet.xmr-tw.org:38081
# API keys for verify.sh --public (recommended; the public endpoints rate-limit).
TURMITE_TRON_API_KEY=
TURMITE_TON_API_KEY=
